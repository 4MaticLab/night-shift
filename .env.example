# Optional AI morning-note service
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
REST_REFLECTION_ACCESS_CODE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Injective EVM Testnet keepsake mint
# Used only by Hardhat when deploying the contract locally.
INJECTIVE_DEPLOYER_PRIVATE_KEY=
# Used only by the Next.js server to sign short-lived EIP-712 mint vouchers.
INJECTIVE_MINT_SIGNER_PRIVATE_KEY=
# Address printed by `npm run contract:deploy`.
INJECTIVE_NFT_CONTRACT_ADDRESS=
# Optional overrides. Defaults point to Injective EVM Testnet and the request origin.
INJECTIVE_EVM_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
INJECTIVE_NFT_METADATA_ORIGIN=
