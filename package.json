{
  "name": "night-shift",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy:sites": "npm run build:sites && npx wrangler deploy --config wrangler.toml",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "bridge:start": "tsx tools/home-assistant-bridge/index.ts",
    "bridge:test": "vitest run tests/home-assistant-bridge.test.ts tests/ambient-hardware.test.ts",
    "connector:start": "tsx apps/connector/main.ts",
    "connector:test": "vitest run tests/connector.test.ts tests/home-assistant-bridge.test.ts tests/ambient-hardware.test.ts",
    "connector:build": "node scripts/build-connectors.mjs",
    "connector:build:all": "node scripts/build-connectors.mjs --all",
    "connector:smoke": "node scripts/smoke-connector.mjs",
    "test": "vitest run",
    "test:render": "npm run build:sites && node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "test:robustness": "npm run test:render && npm run contract:compile && npm run contract:test && npm run test:e2e",
    "contract:compile": "hardhat compile --build-profile production",
    "contract:test": "hardhat test nodejs",
    "contract:deploy": "hardhat ignition deploy ignition/modules/NightShiftKeepsake.ts --network injectiveTestnet",
    "validate:content": "vitest run tests/content.test.ts",
    "docs:check": "node scripts/check-wikilinks.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern artifacts --ignore-pattern cache",
    "db:generate": "drizzle-kit generate",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "bonjour-service": "^1.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "next": "16.2.11",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.55.8",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.46.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "bun": "^1.3.14",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "hardhat": "^3.11.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "type": "module"
}
